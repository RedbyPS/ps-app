<!-- The PS 1.72 'Cake' icon as layers (ps-mac icon/make-icons.py): a dark plum background, the knight on its neon
     globe inside the safe zone, and the knight's silhouette for themed icons. New names with each new icon (ic_cake),
     so no launcher or system cache keeps the old picture. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_cake_back" />
    <foreground android:drawable="@mipmap/ic_cake_front" />
    <monochrome android:drawable="@mipmap/ic_cake_mono" />
</adaptive-icon>
